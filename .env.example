# Klimmeck Guide BE — template. NON contiene secret reali: copia in .env e compila.
PORT=3000
NODE_ENV=development
# Serve un replica set (anche a un solo nodo): le change stream delle subscription (characterUpdated)
# non funzionano su un mongod standalone. Avvio locale: mongod --replSet rs0, poi rs.initiate() in mongosh.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
DB_NAME=klimmeck_guide
REDIS_HOST=localhost
REDIS_PORT=6379
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth (Phase 2) — OBBLIGATORIA, almeno 32 caratteri. Generare con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Twitch OAuth — opzionali finché le chiavi non sono disponibili: se manca una delle tre
# l'app parte comunque e GET /auth/twitch/start reindirizza a klimmeck://auth?error=twitch_not_configured
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
# Scope Twitch richiesti al login (Phase 6, D-11): lista separata da spazi, vuota = solo identità.
# Lo streamer la imposta a channel:read:redemptions, fa login UNA volta (autorizza l'app a ricevere le redemption
# via EventSub) e poi può svuotarla: finché è impostata ogni viewer vede la stessa richiesta di consenso.
# Se il reconcile EventSub logga un 403 sulla subscription delle redemption: rifare quel login.
TWITCH_LOGIN_SCOPES=
# Destinazione finale del login (deep link app scheme://..., validato al boot con new URL()).
# Mai http(s) né schemi da browser (javascript, data, file, ...); niente spazi; niente "_" nello schema.
APP_AUTH_REDIRECT_URL=klimmeck://auth

# Dev bypass (stessi nomi dello stub FE). Attivo SOLO con DEV_AUTH_ENABLED=true esatto;
# con NODE_ENV=production l'app rifiuta di avviarsi.
DEV_AUTH_ENABLED=false
DEV_AUTH_ACCESS_TOKEN=
DEV_AUTH_TWITCH_ID=
DEV_AUTH_ROLE=adventurer

# Push FCM (Phase 5) — JSON del service account Firebase codificato base64 su UNA riga.
# Deve essere lo STESSO progetto Firebase di google-services.json / GoogleService-Info.plist del FE.
# Vuota in development/test = push disabilitato (WARN al boot, sendTestPush → PUSH_DISABLED).
# OBBLIGATORIA con NODE_ENV=production: senza, l'app rifiuta di avviarsi.
# Generazione: macOS `base64 -i service-account.json | tr -d '\n'` — Linux `base64 -w0 service-account.json`
# Il file JSON non va MAI committato (.gitignore: *service-account*.json, *serviceAccount*.json, *firebase-adminsdk*.json).
FIREBASE_SERVICE_ACCOUNT=

# Twitch EventSub (Phase 6) — punti canale → twitchPoints (1:1) e push streamer-live su stream.online.
# Tutte e tre vuote in development/test = EventSub disabilitato (WARN al boot, il webhook risponde 403).
# Parziali o malformate = boot rifiutato ovunque. OBBLIGATORIE con NODE_ENV=production, insieme a TWITCH_CLIENT_ID/SECRET.
# Se il tuo .env ha già TWITCH_EVENTSUB_SECRET e TWITCH_BROADCASTER_ID, aggiungi anche TWITCH_EVENTSUB_CALLBACK_URL o svuota le altre due.
# Secret (10-100 caratteri ASCII): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWITCH_EVENTSUB_SECRET=
# Callback pubblico https://<host>/webhooks/twitch/eventsub (HTTPS, porta 443, nessun redirect).
# http://localhost:3000/webhooks/twitch/eventsub (solo fuori produzione) = modalità locale: webhook attivo per la
# Twitch CLI, nessuna chiamata Helix. Usare un'app Twitch (client_id) distinta per ogni ambiente che gestisce EventSub.
TWITCH_EVENTSUB_CALLBACK_URL=
# Id numerico del canale: twitch api get users -q login=lordreavor   (campo data[0].id)
TWITCH_BROADCASTER_ID=
# Prova locale con la Twitch CLI (stesso secret di TWITCH_EVENTSUB_SECRET):
# twitch event verify-subscription channel.channel_points_custom_reward_redemption.add -F http://localhost:3000/webhooks/twitch/eventsub -s <secret> -b <broadcaster id> -D
# twitch event trigger channel.channel_points_custom_reward_redemption.add -F http://localhost:3000/webhooks/twitch/eventsub -s <secret> -t <broadcaster id> -f <twitchId di un utente loggato> -C 250 -D

# Viaggi (Phase 8) — intervallo dello sweep che completa i viaggi scaduti anche se il job Bull è andato perso
# (eviction Redis dei delayed job, restart). Millisecondi, intero da 0 a 2147483647; vuota = 60000;
# 0 = sweep periodico spento (il reconciler al boot gira comunque). Valore non valido = boot rifiutato. Non è un segreto.
TRAVEL_SWEEP_INTERVAL_MS=

# Esiti delle missioni (Phase 9) — intervallo dello sweep che risolve le missioni standard scadute e i soccorsi oltre i 7 giorni
# anche se il job Bull è andato perso (eviction Redis dei delayed job, restart). Millisecondi, intero da 0 a 2147483647;
# vuota = 60000; 0 = sweep periodico spento (il reconciler al boot gira comunque). Valore non valido = boot rifiutato. Non è un segreto.
QUEST_SWEEP_INTERVAL_MS=
